# Entornos virtuales Python
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class

# Logs y estado de ejecución temporal
logs/*
!logs/.gitkeep
tunnel_status.json
*.log
*.backup*
*.swp
*.swo

# Sistema operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Bases de datos SQLite locales (se auto-generan limpias al arrancar backend/database.py)
*.db
backend/data/*.db
*.sqlite
*.sqlite3

# Certificados de firma electrónica sensibles
backend/uploads/signatures/*.p12
backend/uploads/signatures/*.pfx
!backend/uploads/signatures/.gitkeep
